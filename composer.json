{
    "name": "superconductor/core",
    "description": "The Superconductor MCP framework module for VenusianPHP.",
    "type": "library",
    "version": "0.11.0",
    "keywords": [
        "framework",
        "superconductor",
        "mcp",
        "model-context-protocol",
        "venusian"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/docs/superconductor/overview",
    "support": {
        "issues": "https://github.com/superconductor-mcp/core/issues",
        "source": "https://github.com/superconductor-mcp/core"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ramsey/uuid": "^4.7",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0",
        "venusian-voyager/signals": "^0.11.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "venusian-voyager/config": "^0.11.0",
        "venusian/framework": "^0.11.0"
    },
    "suggest": {
        "superconductor/stdio": "Required to serve and connect to MCP servers over stdio (^0.11.0).",
        "superconductor/web": "Required to serve and connect to MCP servers over HTTP+SSE and Streamable HTTP (^0.11.0)."
    },
    "replace": {
        "superconductor/contracts": "self.version",
        "superconductor/schema": "self.version",
        "superconductor/mechanism": "self.version",
        "superconductor/server": "self.version",
        "superconductor/client": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Fabricate\\": "src/Fabricate/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/app/",
            "Fabricate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Fabricate\\Core\\Providers\\SuperconductorMCPServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
